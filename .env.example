# Smart-Serve — environment template.
#
# Copy to `.env` and edit:
#
#   cp .env.example .env
#
# Docker Compose reads this file and injects the variables into the container; the app
# itself never parses `.env` (ADR-009). Every variable here is optional — the values shown
# are the defaults the container uses when they are unset.
#
# Only *operational* settings live in the environment. Every interpretation threshold
# (temperature limits, sector thresholds, retention, squelch windows) is configured in the
# web UI and stored in SQLite, deliberately: a threshold you must restart the container to
# change is a threshold nobody tunes.

# HTTP listen address. If you change the port, change the compose `ports:` mapping too.
SMARTSERVE_ADDR=:8080

# SQLite database path. Leave this alone unless you mount the data volume elsewhere.
SMARTSERVE_DB=/data/smartserve.db

# URL subpath, for hosting behind a proxy at e.g. https://host/smartserve/ (ADR-015).
# Leave unset (or "/") when the app is served from the root.
#SMARTSERVE_BASE_PATH=/smartserve

# Per-command timeout for smartctl and lsblk, in seconds.
#SMARTSERVE_COMMAND_TIMEOUT=15

# What to do when a scheduled scan was missed while the container was down:
# `skip` waits for the next scheduled fire, `run_once` runs it at startup.
#SMARTSERVE_MISSED_RUN_POLICY=skip

# debug | info | warn | error
#SMARTSERVE_LOG_LEVEL=info

# Timezone used for cron-style schedules and for displayed timestamps.
TZ=Etc/UTC

# --- Notification secrets -------------------------------------------------------------
#
# Deliberately absent. ntfy tokens, webhook headers, bot tokens and SMTP passwords are set
# per channel in the web UI and stored in the database, because they belong to a channel
# rather than to the process. See docs/DEPLOYMENT.md §Secrets.
